# Example environment variables for eProcure
# Copy this to .env and edit values before running

PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eprocure

# Optional: Google reCAPTCHA secret for supplier forms
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=6LdubjYtAAAAAJgv4ABzx2xxxdT42jA3OqhyAp8Y
RECAPTCHA_SECRET_KEY=6LdubjYtAAAAAJDB66LBYg4wppymUtnSIY7nnLoC
VITE_API_BASE_URL=http://localhost:4000

# Comma-separated origin(s) the backend accepts cross-origin, credentialed
# (cookie-carrying) requests from. Must match where the frontend is actually
# served from - the Vite dev server by default, or your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Cross-site cookie settings for the session cookie (also applied to the CSRF
# cookie). Defaults to SameSite=None + Secure=true even locally, because the
# backend (127.0.0.1) and frontend (localhost) run on different hostnames by
# default, which browsers already treat as cross-site - Secure still works
# over plain HTTP on loopback origins (localhost/127.0.0.1 are treated as
# secure contexts by Chrome/Firefox/Safari). Only override these if your
# deployment needs something else.
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true
