# Environment variables for the Django backend.
#
# Copy this file to backend/.env and fill in real values before running the
# server. Every variable below is read with os.getenv() in
# backend/eprocure/settings.py (and backend/ocr/ocr_service.py for the AWS_*
# ones) - if you leave one unset, the default shown here is what the app
# actually falls back to.

# ── Django core ──────────────────────────────────────────────────────────
# Secret key used for session signing etc. The fallback below is fine for
# local development only - always set a real, random value in production.
DJANGO_SECRET_KEY=django-insecure-change-this
# 'True'/'1'/'yes' enables Django's debug error pages. Turn this off
# (DJANGO_DEBUG=False) in any environment reachable by real users.
DJANGO_DEBUG=True
# Comma-separated list of hostnames Django will answer requests for.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ──────────────────────────────────────────────────────────────
# When DJANGO_USE_SQLITE is left at its default ('1'), the app ignores all
# DB_* settings below and uses a local SQLite file (backend/db.sqlite3) that
# Django creates automatically on first `migrate`. You do NOT need MySQL
# installed just to run the app locally. Set DJANGO_USE_SQLITE=0 to switch to
# a real MySQL database (e.g. for something closer to the production setup).
DJANGO_USE_SQLITE=1
# DJANGO_DB_ENGINE=django.db.backends.mysql
# DB_NAME=eprocure
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# ── Email (PR status notifications, RFQ dispatch) ───────────────────────
# Left unset, EMAIL_BACKEND defaults to Django's console backend: outgoing
# email is printed to the terminal running `manage.py runserver` instead of
# actually being sent. That's fine for local testing - switch to an SMTP
# backend and fill in the EMAIL_HOST_* values to send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=BAC Secretariat <no-reply@eprocure.local>

# ── Frontend / session cookies (CORS) ────────────────────────────────────
# Comma-separated origin(s) allowed to make credentialed (cookie-carrying)
# requests to this backend. Must match wherever the frontend is actually
# served from - the Vite dev server by default, or your deployed frontend
# URL in production.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# The frontend and backend normally run on different hostnames (even
# localhost:5173 vs 127.0.0.1:8000 counts as cross-site to the browser), so
# the session cookie needs SameSite=None + Secure=true to be sent back on
# fetch() calls. Secure still works over plain HTTP on localhost/127.0.0.1
# since browsers treat those as secure contexts. Only override these if your
# deployment needs something else.
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true

# ── AWS Textract (PR upload OCR extraction) ─────────────────────────────
# The PR upload/OCR pipeline (backend/ocr/ocr_service.py) calls AWS
# Textract via boto3. Without valid credentials and a region here, PR
# uploads will fail - and on the main upload endpoint (POST /api/upload/)
# that failure is currently NOT caught, so it surfaces as an unhandled
# server error rather than a clean error message. Set all three before
# testing the PR upload feature.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
